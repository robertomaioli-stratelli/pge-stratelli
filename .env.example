APP_ENV=production
APP_DEBUG=false
APP_URL=http://stratelli.local
APP_ENFORCE_HOST=true
APP_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
SESSION_NAME=INPACTA_SESSION
SESSION_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=480
PASSWORD_RESET_SHOW_LINK_LOCAL=false
PASSWORD_RESET_MINUTES=30

# E-mail transacional / recuperação de senha (produção)
MAIL_ENABLED=true
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@seudominio.com.br
MAIL_PASSWORD=troque-pela-senha-ou-app-password
MAIL_FROM=no-reply@seudominio.com.br
MAIL_FROM_NAME=INPACTA By Stratelli
MAIL_TIMEOUT=20
MAIL_VERIFY_PEER=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inpacta
DB_USER=inpacta
DB_PASS=troque-a-senha


# Geocodificação territorial (v4.1)
# O provedor público Nominatim deve ser usado apenas em volume moderado e respeitando sua política de uso.
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=INPACTA/4.1 (+https://seu-dominio.example)
GEOCODING_EMAIL=
GEOCODING_CACHE_TTL=2592000
